  {
   "id": 115,
   "type": "barchart",
   "title": "Node Root Filesystem Utilisation",
   "description": "Root filesystem usage per node, highest first. Ceph monitors raise MON_DISK_LOW when free space drops below ~30%, which is why this panel leads the dashboard. Thresholds: <70% healthy, 70-80% warning, 80-90% high, >90% critical.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-uid"
   },
   "gridPos": {
    "h": 9,
    "w": 14,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "green",
        "value": 0
       },
       {
        "color": "#EAB839",
        "value": 70
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     },
     "noValue": "NO DATA",
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 80,
      "axisPlacement": "auto",
      "axisBorderShow": false,
      "hideFrom": {
       "legend": false,
       "tooltip": false,
       "viz": false
      }
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "showValue": "auto",
    "xTickLabelRotation": 0,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": false
    },
    "tooltip": {
     "mode": "single",
     "sort": "none",
     "hideZeros": false
    }
   },
   "pluginVersion": "12.1.1",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-uid"
     },
     "expr": "(node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}) / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} * 100",
     "legendFormat": "{{instance}}",
     "instant": true,
     "format": "time_series",
     "editorMode": "code",
     "range": false
    }
   ]
  },
