   "id": 108,
   "type": "table",
   "title": "Container Waiting Reasons",
   "description": "Why containers are not running right now — ImagePullBackOff, CrashLoopBackOff, CreateContainerConfigError etc. Empty table = no containers waiting.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-uid"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 17
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "NO DATA",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true,
      "inspect": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Reason"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "CrashLoopBackOff": {
            "color": "red",
            "index": 0
           },
           "ImagePullBackOff": {
            "color": "orange",
            "index": 1
           },
           "ErrImagePull": {
            "color": "orange",
            "index": 2
           },
           "ContainerCreating": {
            "color": "#EAB839",
            "index": 3
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true,
    "footer": {
