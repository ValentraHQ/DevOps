  {
   "id": 132,
   "type": "table",
   "title": "Pod Restart Leaderboard",
   "description": "Every container in utm-* namespaces ranked by cumulative restarts, with the 1h restart rate and current waiting reason. A container with thousands of restarts is visible here even when cluster averages look normal.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-uid"
   },
   "gridPos": {
    "h": 11,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "NO DATA",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true,
      "inspect": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Total Restarts"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "gradient"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "green",
           "value": 0
          },
          {
           "color": "#EAB839",
           "value": 10
          },
          {
           "color": "orange",
           "value": 100
          },
          {
           "color": "red",
           "value": 1000
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Restarts (1h)"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "green",
           "value": 0
          },
          {
           "color": "#EAB839",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Waiting"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     }
    ]
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true,
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    },
    "sortBy": [
     {
      "desc": true,
      "displayName": "Total Restarts"
     }
    ]
   },
   "pluginVersion": "12.1.1",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-uid"
     },
     "expr": "sum by (namespace,pod,container) (kube_pod_container_status_restarts_total{namespace=~\"utm-core|utm-services|utm-skyzr|utm-aviamaps|utm-statistics|utm-devops\"})",
     "legendFormat": "",
     "instant": true,
     "format": "table",
     "editorMode": "code",
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-uid"
     },
     "expr": "sum by (namespace,pod,container) (increase(kube_pod_container_status_restarts_total{namespace=~\"utm-core|utm-services|utm-skyzr|utm-aviamaps|utm-statistics|utm-devops\"}[1h]))",
     "legendFormat": "",
     "instant": true,
     "format": "table",
     "editorMode": "code",
     "range": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-uid"
     },
     "expr": "sum by (namespace,pod,reason) (kube_pod_container_status_waiting_reason{namespace=~\"utm-core|utm-services|utm-skyzr|utm-aviamaps|utm-statistics|utm-devops\"} > 0)",
     "legendFormat": "",
     "instant": true,
     "format": "table",
     "editorMode": "code",
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "pod",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "namespace 2": true,
       "namespace 3": true,
       "container 2": true
      },
      "renameByName": {
       "namespace 1": "Namespace",
       "namespace": "Namespace",
       "pod": "Pod",
       "container 1": "Container",
       "container": "Container",
       "Value #A": "Total Restarts",
       "Value #B": "Restarts (1h)",
       "reason": "Waiting Reason",
       "Value #C": "Waiting"
      }
     }
    }
   ]
  },
