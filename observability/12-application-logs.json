{
 "uid": "utm-obs-12-logs",
 "title": "12 - Application Logs",
 "description": "**Purpose:** browse real container logs across every utm-* namespace, shipped by the alloy-logs DaemonSet into Loki. Pick a namespace from the dropdown above to filter; use the Logs panel's own search box to narrow further within it.\n\n**Data source:** Loki (`loki-uid`), fed by `alloy-logs.yaml`. See dashboard 08 panel 110 for how this was verified end-to-end.\n\n**Note:** a pod with no entries here has not written anything to stdout/stderr in the selected time range — that's a property of the container, not a gap in this pipeline (verified against `utm-core/dns-test`, `utm-services/service-registry-mysql`, `utm-services/smartsis-client`, none of which have ever logged anything, in or out of Loki).",
 "tags": [
  "utm-observability",
  "logs",
  "loki"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "weekStart": "",
 "refresh": "30s",
 "preload": false,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "30s",
   "1m",
   "5m",
   "15m",
   "30m",
   "1h"
  ],
  "time_options": [
   "15m",
   "1h",
   "6h",
   "24h",
   "7d",
   "30d"
  ]
 },
 "fiscalYearStartMonth": 0,
 "templating": {
  "list": [
   {
    "name": "namespace",
    "type": "query",
    "label": "Namespace",
    "datasource": {
     "type": "loki",
     "uid": "loki-uid"
    },
    "query": "label_values({namespace=~\"utm-.*\"}, namespace)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "allValue": ".*",
    "multi": false,
    "current": {}
   }
  ]
 },
